# ==========================================
# Syncora Environment Configuration
# ==========================================

# PostgreSQL Connection String (Neon Pooled connection for runtime queries)
# Example: postgresql://[user]:[password]@[neon-hostname]/syncora?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/syncora?schema=public"

# Direct PostgreSQL Connection String (Used for Prisma migrations bypassing PgBouncer)
# Example: postgresql://[user]:[password]@[neon-hostname]/syncora?sslmode=require
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/syncora?schema=public"

# Secret key used for signing and verifying custom JWT authentication tokens
# Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-secure-random-secret-key-min-32-chars"

# Base URL of the application (used for absolute URLs, invite links, and CORS)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"
